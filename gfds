-- NO GAS CAR SPEEDHACK (V to toggle while seated in a vehicle)
--==================================================

local carFlySettings = {
    enabled = false,
    speed = 100,
    rotationSpeed = 8,
    maxDistance = 1000,
    toggleKey = Enum.KeyCode.V
}

local carFlying = false
local flyVehicle = nil
local flySeat = nil

local function getFlyVehicle()
    local character = localPlayer.Character
    if not character then
        return nil, nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return nil, nil
    end

    local currentSeat = humanoid.SeatPart

    if not currentSeat or not currentSeat:IsA("VehicleSeat") then
        return nil, nil
    end

    local model = currentSeat:FindFirstAncestorOfClass("Model")

    if not model then
        return nil, nil
    end

    return model, currentSeat
end

local carFlyToggleRef = nil -- menu toggle reference (set after UI is built)

local function disableCarFly(notifyUser)
    carFlying = false
    flyVehicle = nil
    flySeat = nil
    if notifyUser then
        library:notify("Car speedhack disabled")
    end
end

local function enableCarFly(notifyUser)
    local model, currentSeat = getFlyVehicle()

    if not model then
        library:notify("Sit in a VehicleSeat first!")
        warn("[CarFly] You must be sitting in a VehicleSeat.")
        -- keep menu toggle in sync (turn back off)
        if library.options["carfly enabled"] then
            library.options["carfly enabled"].changeState(false)
        end
        return
    end

    flyVehicle = model
    flySeat = currentSeat
    carFlying = true
    if notifyUser then
        library:notify("Car speedhack enabled")
    end
end

local function setCarFly(state)
    carFlySettings.enabled = state
    if state then
        enableCarFly(false)
    else
        disableCarFly(false)
    end
end

-- V key toggles (works even when menu is closed)
inputService.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end

    if input.KeyCode == carFlySettings.toggleKey and library.flags["carfly enabled"] == true then
        if carFlying then
            disableCarFly(true)
        else
            enableCarFly(true)
        end
    end
end)

-- reset on respawn
localPlayer.CharacterAdded:Connect(function()
    disableCarFly(false)
end)

runService.RenderStepped:Connect(function(dt)
    if not carFlying then
        return
    end

    if carFlySettings.enabled == false then
        disableCarFly(false)
        return
    end

    if not flyVehicle or not flyVehicle.Parent or not flySeat or not flySeat.Parent then
        disableCarFly(false)
        return
    end

    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.SeatPart ~= flySeat then
        disableCarFly(true)
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    -- Mouse position in 3D world.
    local mouseRay = camera:ScreenPointToRay(
        mouse.X,
        mouse.Y
    )

    local origin = mouseRay.Origin
    local direction = mouseRay.Direction.Unit

    -- Put the target point far in front of the camera.
    local targetPosition =
        origin + direction * carFlySettings.maxDistance

    local currentPivot = flyVehicle:GetPivot()
    local currentPosition = currentPivot.Position

    local offset = targetPosition - currentPosition
    local distance = offset.Magnitude

    if distance < 1 then
        return
    end

    -- Don't instantly teleport the vehicle.
    local moveDistance = math.min(
        carFlySettings.speed * dt,
        distance
    )

    local newPosition =
        currentPosition +
        offset.Unit * moveDistance

    -- Face the vehicle toward the mouse.
    local lookDirection = offset.Unit

    local targetCFrame = CFrame.lookAt(
        newPosition,
        newPosition + lookDirection,
        Vector3.yAxis
    )

    -- Smooth the rotation so it doesn't violently spin.
    local rotationAlpha =
        math.clamp(carFlySettings.rotationSpeed * dt, 0, 1)

    local currentRotation =
        CFrame.lookAt(
            currentPosition,
            currentPosition + currentPivot.LookVector,
            Vector3.yAxis
        )

    local smoothRotation =
        currentRotation:Lerp(targetCFrame, rotationAlpha)

    flyVehicle:PivotTo(
        CFrame.new(newPosition) *
        (
            smoothRotation -
            smoothRotation.Position
        )
    )
end)

--==================================================
-- HIGH JUMP / INFINITE JUMP
--==================================================

local jumpSettings = {
    highJumpEnabled = false,
    jumpPower = 90,
    infiniteJump = false
}

-- store defaults so disabling restores the character's original jump
local storedUseJumpPower = nil
local storedJumpPower = nil
local storedJumpHeight = nil

local function applyJumpToCharacter(character)
    if not jumpSettings.highJumpEnabled then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        -- character might not be fully loaded yet
        humanoid = character:WaitForChild("Humanoid", 5)
        if not humanoid then return end
    end

    -- capture originals once (before we touch anything)
    if storedUseJumpPower == nil then
        storedUseJumpPower = humanoid.UseJumpPower
        storedJumpPower = humanoid.JumpPower
        storedJumpHeight = humanoid.JumpHeight
    end

    humanoid.UseJumpPower = true
    humanoid.JumpPower = jumpSettings.jumpPower
end

local function restoreJump(character)
    character = character or localPlayer.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    if storedUseJumpPower ~= nil then
        humanoid.UseJumpPower = storedUseJumpPower
        humanoid.JumpPower = storedJumpPower
        humanoid.JumpHeight = storedJumpHeight
        storedUseJumpPower = nil
        storedJumpPower = nil
        storedJumpHeight = nil
    end
end

local function setHighJump(state)
    jumpSettings.highJumpEnabled = state
    if state then
        applyJumpToCharacter(localPlayer.Character)
    else
        restoreJump()
    end
end

local function setJumpPower(value)
    jumpSettings.jumpPower = value
    if jumpSettings.highJumpEnabled then
        local character = localPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.UseJumpPower = true
                humanoid.JumpPower = value
            end
        end
    end
end

-- re-apply on respawn / character change
localPlayer.CharacterAdded:Connect(function(character)
    if jumpSettings.highJumpEnabled then
        task.wait(0.2) -- let the character finish loading
        applyJumpToCharacter(character)
    end
end)

-- infinite jumps (fires on every jump request while enabled)
inputService.JumpRequest:Connect(function()
    if not jumpSettings.infiniteJump then
        return
    end

    local character = localPlayer.Character
    if not character then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.Jump = true
    end
end)

