-- NO GAS CAR SPEEDHACK (functional, from original)
--==================================================

local carFlySettings = {
    enabled = false,
    speed = 100,
    rotationSpeed = 8,
    maxDistance = 1000
}

local carFlying = false
local flyVehicle = nil
local flySeat = nil

local function getFlyVehicle()
    local character = LocalPlayer.Character
    if not character then return nil, nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil, nil end
    local currentSeat = humanoid.SeatPart
    if not currentSeat or not currentSeat:IsA("VehicleSeat") then
        return nil, nil
    end
    local model = currentSeat:FindFirstAncestorOfClass("Model")
    if not model then return nil, nil end
    return model, currentSeat
end

local function disableCarFly(notifyUser)
    carFlying = false
    flyVehicle = nil
    flySeat = nil
    if notifyUser then
        notify("Car speedhack disabled")
    end
end

local function enableCarFly(notifyUser)
    local model, currentSeat = getFlyVehicle()
    if not model then
        notify("Sit in a VehicleSeat first!")
        warn("[CarFly] You must be sitting in a VehicleSeat.")
        if Options["carfly enabled"] then
            Options["carfly enabled"].changeState(false)
        end
        return
    end
    flyVehicle = model
    flySeat = currentSeat
    carFlying = true
    if notifyUser then
        notify("Car speedhack enabled")
    end
end

local function setCarFly(state)
    carFlySettings.enabled = state
    if state then
        enableCarFly(false)
    else
        disableCarFly(false)
    end
end

local function getInputKey(input)
    if input.KeyCode ~= Enum.KeyCode.Unknown then
        return input.KeyCode
    end
    return input.UserInputType
end

local function toggleCarFly(notifyUser)
    if carFlying then
        disableCarFly(notifyUser)
        if Options["carfly enabled"] then
            Options["carfly enabled"].changeState(false)
        end
    else
        enableCarFly(notifyUser)
        if carFlying and Options["carfly enabled"] then
            Options["carfly enabled"].changeState(true)
        end
    end
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    local boundKey = Flags["carfly key"]
    if typeof(boundKey) ~= "EnumItem" then return end
    if boundKey == Enum.KeyCode.Unknown then return end
    if getInputKey(input) ~= boundKey then return end
    toggleCarFly(true)
end)

LocalPlayer.CharacterAdded:Connect(function()
    disableCarFly(false)
end)

RunService.RenderStepped:Connect(function(dt)
    if not carFlying then return end
    if carFlySettings.enabled == false then
        disableCarFly(false)
        return
    end
    if not flyVehicle or not flyVehicle.Parent or not flySeat or not flySeat.Parent then
        disableCarFly(false)
        return
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.SeatPart ~= flySeat then
        disableCarFly(true)
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local mouseRay = camera:ScreenPointToRay(mouse.X, mouse.Y)
    local origin = mouseRay.Origin
    local direction = mouseRay.Direction.Unit
    local targetPosition = origin + direction * carFlySettings.maxDistance

    local currentPivot = flyVehicle:GetPivot()
    local currentPosition = currentPivot.Position
    local offset = targetPosition - currentPosition
    local distance = offset.Magnitude

    if distance < 1 then return end

    local moveDistance = math.min(carFlySettings.speed * dt, distance)
    local newPosition = currentPosition + offset.Unit * moveDistance

    local lookDirection = offset.Unit
    local targetCFrame = CFrame.lookAt(newPosition, newPosition + lookDirection, Vector3.yAxis)
    local rotationAlpha = math.clamp(carFlySettings.rotationSpeed * dt, 0, 1)
    local currentRotation = CFrame.lookAt(currentPosition, currentPosition + currentPivot.LookVector, Vector3.yAxis)
    local smoothRotation = currentRotation:Lerp(targetCFrame, rotationAlpha)

    flyVehicle:PivotTo(CFrame.new(newPosition) * (smoothRotation - smoothRotation.Position))
end)

