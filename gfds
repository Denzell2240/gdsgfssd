    if chamsEnabled then
        for _,plr in next, players:GetPlayers() do
            applyChams(plr)
        end
        updateChams()
    end

    -- ESP with periodic full refresh so drawings can't get stuck/glitched
    if espSettings.enabled then
        if os.clock() - lastEspRefresh > ESP_REFRESH_INTERVAL then
            forceEspRefresh()
        end
        for _,plr in next, players:GetPlayers() do
            updateEspPlayer(plr, camera)
        end
    else
        if next(espObjects) then
            clearEsp()
        end
    end
end)

-- Vehicle ESP distance/render loop (separate so player ESP stays unaffected)
runService.RenderStepped:Connect(function()
    if not vehicleESPSettings.enabled then
        return
    end

    local character = localPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    for vehicle, data in pairs(vehicleESP) do
        if vehicle.Parent and data.part and data.part.Parent then
            local distance = math.floor(
                (root.Position - data.part.Position).Magnitude
            )

            -- distance limit
            if distance > vehicleESPSettings.maxdistance then
                data.highlight.Enabled = false
                data.billboard.Enabled = false
            else
                data.highlight.Enabled = true
                data.billboard.Enabled = true
            end

            if vehicleESPSettings.showdistance then
                data.label.Text = vehicle.Name .. " [" .. distance .. "m]"
            else
                data.label.Text = vehicle.Name
            end
        else
            removeVehicleESP(vehicle)
        end
    end
end)

