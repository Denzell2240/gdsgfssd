local function notify(text)
    if not notifyText then return end
    if notifyPlaying then return end
    notifyPlaying = true
    notifyText.Text = text
    notifyText.Transparency = 0
    notifyText.Visible = true
    task.spawn(function()
        for i = 0, 1, 0.1 do task.wait() notifyText.Transparency = i end
