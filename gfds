-- rebuilds the excluded-players dropdown from the current server roster
refreshExcludedList = function()
    local opt = library.options["aimbot excluded"]
    if not opt then return end

    -- snapshot the current selection so a refresh doesn't wipe it
    local prevSet = {}
    local selection = library.flags["aimbot excluded"]
    if type(selection) == "table" then
        for _, v in ipairs(selection) do
            prevSet[v] = true
        end
    end

    -- build the fresh name list
    local names = {}
    for _, plr in ipairs(players:GetPlayers()) do
        if plr ~= localPlayer then
            table.insert(names, plr.Name)
        end
    end
    table.sort(names)

    opt.refresh(names)

    -- the library's refresh auto-toggles the first entry on/off;
    -- toggle it back so the selection stays exactly as the user left it
    if names[1] then
        opt.changeState(names[1])
        if prevSet[names[1]] then
            opt.changeState(names[1]) -- restore it if it WAS selected
        end
    end
end

