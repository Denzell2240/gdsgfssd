local function startHitNotifier()
    if hitNotifierConnection then return end

    task.spawn(function()
        local remotes = ReplicatedStorage:WaitForChild("CLIENT_REMOTES", 15)
        if not remotes then warn("[HitNotifier] CLIENT_REMOTES not found") return end
        local gunRemotes = remotes:WaitForChild("GUN_REMOTES", 15)
        if not gunRemotes then warn("[HitNotifier] GUN_REMOTES not found") return end
        local shotResult = gunRemotes:WaitForChild("ShotResultV8", 15)
        if not shotResult then warn("[HitNotifier] ShotResultV8 not found") return end

        buildHitNotifierGui()

        hitNotifierConnection = shotResult.OnClientEvent:Connect(function(result)
            if not hitNotifierSettings.enabled then return end
            if type(result) ~= "table" then return end
            if result.Fired ~= true then return end
            if type(result.Pellets) ~= "table" then return end

            if os.clock() - hitNotifierSettings.lastNotify < 0.15 then return end

            for _, pellet in ipairs(result.Pellets) do
                if type(pellet) ~= "table" then continue end
                if type(pellet.Contacts) ~= "table" then continue end

                for _, contact in ipairs(pellet.Contacts) do
                    if type(contact) ~= "table" then continue end

                    local damage = tonumber(contact.Damage)
                    local zone = tostring(contact.Zone or "")

                    if damage
                        and damage > 0
                        and damage >= hitNotifierSettings.minDamage
                        and zone:lower() == "head" then

                        hitNotifierSettings.lastNotify = os.clock()
                        showHeadHit(math.floor(damage))
                        break
                    end
                end
            end
        end)
    end)
end

local function stopHitNotifier()
    if hitNotifierConnection then
        hitNotifierConnection:Disconnect()
        hitNotifierConnection = nil
    end
    destroyHitNotifierGui()
end

