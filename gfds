local function accentDark()
    return ACCENT:Lerp(Color3.new(0, 0, 0), 0.35)
end

local function setAccent(color)
    ACCENT = color
    for _, b in ipairs(accentBindings) do
        b.obj[b.prop] = b.dark and accentDark() or ACCENT
    end
    for _, t in ipairs(allToggles) do t.render() end
    for _, s in ipairs(allSliders) do
        s.fill.BackgroundColor3 = ACCENT
        s.knob.BackgroundColor3 = ACCENT
        s.value.TextColor3 = ACCENT
    end
end

