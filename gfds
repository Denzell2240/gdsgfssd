--==================================================
-- DRAGGING
--==================================================

local dragging = false
local dragStart
local startPosition

Top.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
        return
    end
    dragging = true
    dragStart = input.Position
    startPosition = Main.Position
end)

Top.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end
    local delta = input.Position - dragStart
    Main.Position = UDim2.new(
        startPosition.X.Scale,
        startPosition.X.Offset + delta.X,
        startPosition.Y.Scale,
        startPosition.Y.Offset + delta.Y
    )
end)

--==================================================
-- MENU TOGGLE (RightShift, animated like the new UI)
--==================================================

local menuVisible = true
local animating = false

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode ~= MENU_KEY then return end
    if animating then return end

    animating = true
    menuVisible = not menuVisible

    if menuVisible then
        Main.Visible = true
        Main.Position = UDim2.new(0.5, -380, 0.5, -245)
        local tween = TweenService:Create(
            Main,
            TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {Position = UDim2.new(0.5, -380, 0.5, -270)}
        )
        tween:Play()
        tween.Completed:Wait()
    else
        local tween = TweenService:Create(
            Main,
            TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
            {Position = UDim2.new(0.5, -380, 0.5, -245)}
        )
        tween:Play()
        tween.Completed:Wait()
        Main.Visible = false
    end

    animating = false
end)

