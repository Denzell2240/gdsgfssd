local function contains(list, x)
    for _, v in pairs(list) do
        if v == x then return true end
    end
    return false
end

local function buildConfigTable()
    local jig = {}
    for i, v in next, Flags do
        if not Options[i] then continue end
        if Options[i].skipflag then continue end
        if typeof(v) == "Color3" then
            jig[i] = {v.R, v.G, v.B}
        elseif typeof(v) == "EnumItem" then
            jig[i] = {string.split(tostring(v), ".")[2], string.split(tostring(v), ".")[3]}
        else
            jig[i] = v
        end
    end
    return jig
end

local function createConfig()
    local name = Flags["config_name"]
    if contains(Options["selected_config"].values, name) then return notify(name .. ".cfg already exists!") end
    if name == "" then return notify("Put a name goofy") end
    writefile("OsirisCFGS/" .. name .. ".cfg", HttpService:JSONEncode(buildConfigTable()))
    notify("Succesfully created config " .. name .. ".cfg!")
    refreshConfigList()
end

local function saveConfig()
    local name = Flags["selected_config"]
    writefile("OsirisCFGS/" .. name .. ".cfg", HttpService:JSONEncode(buildConfigTable()))
    notify("Succesfully updated config " .. name .. ".cfg!")
    refreshConfigList()
end

local function loadConfig()
    local name = Flags["selected_config"]
    if not isfile("OsirisCFGS/" .. name .. ".cfg") then
        return notify("Config file not found!")
    end
    local ok, config = pcall(function()
        return HttpService:JSONDecode(readfile("OsirisCFGS/" .. name .. ".cfg"))
    end)
    if not ok or type(config) ~= "table" then
        return notify("Config file is corrupted!")
    end

    for i, v in next, Options do
        task.spawn(function()
            pcall(function()
                if config[i] ~= nil then
                    if v.type == "colorpicker" and type(config[i]) == "table" then
                        v.changeState(Color3.new(config[i][1], config[i][2], config[i][3]))
                    elseif v.type == "keybind" and type(config[i]) == "table" then
                        v.changeState(Enum[config[i][1]][config[i][2]])
                    elseif v.type == "multiselect" then
                        if type(config[i]) == "table" then
                            local tbl = {}
                            for _, val in ipairs(config[i]) do
                                if table.find(v.values or {}, val) then
                                    table.insert(tbl, val)
                                end
                            end
                            v.changeState(tbl)
                        else
                            v.changeState({})
                        end
                    else
                        if config[i] ~= Flags[i] then
                            v.changeState(config[i])
                        end
                    end
                else
                    if v.type == "toggle" then
                        v.changeState(false)
                    elseif v.type == "slider" then
                        v.changeState(v.oldargs.value or 0)
                    elseif v.type == "list" then
                        v.changeState(v.oldargs.value or (v.values and v.values[1]) or "")
                    elseif v.type == "textbox" then
                        v.changeState(v.oldargs.value or v.oldargs.text or "")
                    elseif v.type == "colorpicker" then
                        v.changeState(v.oldargs.color or Color3.new(1, 1, 1))
                    elseif v.type == "keybind" then
                        v.changeState(v.oldargs.key or Enum.KeyCode.Unknown)
                    end
                end
            end)
        end)
    end
    notify("Succesfully loaded config " .. name .. ".cfg!")
end

function refreshConfigList()
    if not isfolder("OsirisCFGS") then makefolder("OsirisCFGS") end
    local tbl = {}
    local ok, files = pcall(listfiles, "OsirisCFGS")
    if ok then
        for i, v in next, files do
            local name = string.gsub(v, "OsirisCFGS/", "")
            name = string.gsub(name, ".cfg", "")
            table.insert(tbl, name)
        end
    end
    if Options["selected_config"] then
        Options["selected_config"].refresh(tbl)
    end
end

local function deleteConfig()
    if isfile("OsirisCFGS/" .. Flags["selected_config"] .. ".cfg") then
        delfile("OsirisCFGS/" .. Flags["selected_config"] .. ".cfg")
        refreshConfigList()
    end
end

