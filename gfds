local tracerConfig = {
    enabled = false,
    lifetime = 0.08,               -- how long tracers last (seconds)
    widthStart = 0.08,             -- beam start width (studs)
    widthEnd = 0.02,              -- beam end width (studs)
    color = Color3.fromRGB(255, 45, 210)
}

--------------------------------------------------
-- Find the weapon's actual muzzle attachment
--------------------------------------------------

local function findTracerOrigin()
    local character = localPlayer.Character
    if not character then
        return nil
    end

    -- Preferred muzzle
    local muzzle = character:FindFirstChild("GunMuzzlePoint", true)

    if muzzle and muzzle:IsA("Attachment") then
        return muzzle
    end

    -- Fallback fire point
    local firePoint = character:FindFirstChild("GunFirePoint", true)

    if firePoint and firePoint:IsA("Attachment") then
        return firePoint
    end

    return nil
end

--------------------------------------------------
-- Create visual tracer
--------------------------------------------------

local function createTracer(originAttachment, targetPosition)
    if not originAttachment then
        return
    end

    local endpoint = Instance.new("Part")
    endpoint.Name = "_TracerEndpoint"
    endpoint.Size = Vector3.new(0.05, 0.05, 0.05)
    endpoint.Transparency = 1
    endpoint.Anchored = true
    endpoint.CanCollide = false
    endpoint.CanTouch = false
    endpoint.CanQuery = false
    endpoint.Position = targetPosition
    endpoint.Parent = workspace

    local endAttachment = Instance.new("Attachment")
    endAttachment.Name = "_TracerEnd"
    endAttachment.Parent = endpoint

    local beam = Instance.new("Beam")
    beam.Name = "_BulletTracer"

    beam.Attachment0 = originAttachment
    beam.Attachment1 = endAttachment

    beam.Width0 = tracerConfig.widthStart
    beam.Width1 = tracerConfig.widthEnd

    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.LightInfluence = 0

    beam.Color = ColorSequence.new(tracerConfig.color)

    beam.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 0)
    })

    beam.Parent = originAttachment.Parent

    debris:AddItem(beam, tracerConfig.lifetime)
    debris:AddItem(endpoint, tracerConfig.lifetime)
end

--------------------------------------------------
-- Fire visual tracer
--------------------------------------------------

mouse.Button1Down:Connect(function()
    if not tracerConfig.enabled then return end

    local origin = findTracerOrigin()
    if not origin then
        return
    end

    createTracer(origin, mouse.Hit.Position)
end)

