local function removeWeaponDisplay(player)
    local character = player.Character
    if not character then return end
    local old = character:FindFirstChild("HeldWeaponDisplay")
    if old then
        old:Destroy()
    end
end

local function clearAllWeaponDisplays()
    for _, plr in next, Players:GetPlayers() do
        removeWeaponDisplay(plr)
    end
end

local function updateWeaponDisplay(player)
    if not espSettings.itemesp then return end
    local character = player.Character
    if not character then return end
    if player == LocalPlayer then return end

    if espSettings.teamcheck and player.Team == LocalPlayer.Team then
        removeWeaponDisplay(player)
        return
    end

    local tool = nil
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            tool = child
            break
        end
    end

    removeWeaponDisplay(player)
    if not tool then return end

    local head = character:FindFirstChild("Head")
    if not head then return end

    -- don't show weapon labels on dead players either
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        removeWeaponDisplay(player)
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then return end
    local distance = (camera.CFrame.Position - head.Position).Magnitude
    if distance > espSettings.itemdistance then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "HeldWeaponDisplay"
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(180, 35)
    billboard.StudsOffset = Vector3.new(0, espSettings.names and 4.5 or 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = character

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = tool.Name
    label.TextSize = 16
    label.Font = Enum.Font.GothamBold
    label.TextColor3 = isAlly(player) and espSettings.allycolor or espSettings.namecolor
    label.TextStrokeTransparency = 0
    label.Parent = billboard
end

local function watchPlayer(player)
    local function watchCharacter(character)
        character.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                updateWeaponDisplay(player)
            end
        end)
        character.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then
                task.defer(updateWeaponDisplay, player)
            end
        end)
        updateWeaponDisplay(player)
    end

    if player.Character then
        watchCharacter(player.Character)
    end

    player.CharacterAdded:Connect(watchCharacter)
end

for _, player in ipairs(Players:GetPlayers()) do
    watchPlayer(player)
end

Players.PlayerAdded:Connect(watchPlayer)

