refreshExcludedList = function()
    local opt = Options["aimbot excluded"]
    if not opt then return end

    local prevSet = {}
    local selection = Flags["aimbot excluded"]
    if type(selection) == "table" then
        for _, v in ipairs(selection) do
            prevSet[v] = true
        end
    end

    local names = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(names, plr.Name)
        end
    end
    table.sort(names)

    opt.refresh(names)

    if names[1] then
        opt.changeState(names[1])
        if prevSet[names[1]] then
            opt.changeState(names[1])
        end
    end
end

