local function addSlider(group, args)
    local flag = args.flag or args.text
    local min, max = args.min or 0, args.max or 100
    local value = args.value or min

    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, 0, 0, 62)
    Row.BackgroundTransparency = 1
    Row.LayoutOrder = #group:GetChildren() + 1
    Row.Parent = group

    local Title = Instance.new("TextLabel")
    Title.BackgroundTransparency = 1
    Title.Position = UDim2.new(0, 14, 0, 7)
    Title.Size = UDim2.new(1, -100, 0, 18)
    Title.Font = Enum.Font.GothamSemibold
    Title.Text = args.text
    Title.TextColor3 = COLORS.Text
    Title.TextSize = 11
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Row

    local Value = Instance.new("TextLabel")
    Value.BackgroundTransparency = 1
    Value.AnchorPoint = Vector2.new(1, 0)
    Value.Position = UDim2.new(1, -14, 0, 7)
    Value.Size = UDim2.new(0, 80, 0, 18)
    Value.Font = Enum.Font.GothamBold
    Value.Text = tostring(value)
    Value.TextColor3 = ACCENT
    Value.TextSize = 10
    Value.TextXAlignment = Enum.TextXAlignment.Right
    Value.Parent = Row

    local Bar = Instance.new("Frame")
    Bar.Position = UDim2.new(0, 14, 0, 38)
    Bar.Size = UDim2.new(1, -28, 0, 4)
    Bar.BackgroundColor3 = COLORS.ToggleOff
    Bar.BorderSizePixel = 0
    Bar.Parent = Row
    corner(Bar, 4)

    local function initialPercent(v)
        return max > min and math.clamp((v - min) / (max - min), 0, 1) or 0
    end

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new(initialPercent(value), 0, 1, 0)
    Fill.BackgroundColor3 = ACCENT
    Fill.BorderSizePixel = 0
    Fill.Parent = Bar
    corner(Fill, 4)

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 10, 0, 10)
    Knob.AnchorPoint = Vector2.new(0.5, 0.5)
    Knob.Position = UDim2.new(initialPercent(value), 0, 0.5, 0)
    Knob.BackgroundColor3 = ACCENT
    Knob.BorderSizePixel = 0
    Knob.Parent = Bar
    corner(Knob, 10)

    local function render(v)
        local p = initialPercent(v)
        Fill.Size = UDim2.new(p, 0, 1, 0)
        Knob.Position = UDim2.new(p, 0, 0.5, 0)
        Value.Text = tostring(v) .. (args.suffix or "")
    end

    local function set(newValue)
        value = math.clamp(math.floor(newValue + 0.5), min, max)
        Flags[flag] = value
        render(value)
        if args.callback then
            args.callback(value)
        end
    end

    local function updateFromX(x)
        local p = math.clamp((x - Bar.AbsolutePosition.X) / math.max(Bar.AbsoluteSize.X, 1), 0, 1)
        set(min + (max - min) * p)
    end

    Bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            activeDrag = updateFromX
            updateFromX(input.Position.X)
        end
    end)

    Options[flag] = {
        type = "slider",
        changeState = function(v) set(v) end,
        skipflag = args.skipflag,
        oldargs = args
    }
    table.insert(allSliders, {fill = Fill, knob = Knob, value = Value})

    set(value)

    return {set = set}
end

