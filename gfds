local function isAlly(plr)
    return espSettings.teamcheck and plr.Team == LocalPlayer.Team
end

local function updateEspPlayer(plr, camera)
    if not espSettings.enabled or plr == LocalPlayer then return end
    local char = plr.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char.PrimaryPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    local distance = (camera.CFrame.Position - root.Position).Magnitude
    if distance > espSettings.maxdistance then return end

    local obj = espObjects[plr]
    if not obj then
        obj = createEspDrawings()
        espObjects[plr] = obj
    end

    local cf, size = char:GetBoundingBox()
    local topPos, topVis = camera:WorldToViewportPoint(cf.Position + Vector3.new(0, size.Y / 2, 0))
    local bottomPos, botVis = camera:WorldToViewportPoint(cf.Position - Vector3.new(0, size.Y / 2, 0))
    if not topVis and not botVis then
        for _, l in next, obj.box do l.Visible = false end
        obj.healthBack.Visible = false
        obj.healthBar.Visible = false
        obj.nameText.Visible = false
        obj.distanceText.Visible = false
        obj.tracer.Visible = false
        return
    end

    local boxHeight = math.abs(topPos.Y - bottomPos.Y)
    local boxWidth = boxHeight / 2
    local topLeft = Vector2.new(topPos.X - boxWidth / 2, topPos.Y)
    local topRight = Vector2.new(topPos.X + boxWidth / 2, topPos.Y)
    local botLeft = Vector2.new(topLeft.X, bottomPos.Y)
    local botRight = Vector2.new(topRight.X, bottomPos.Y)

    local color = isAlly(plr) and espSettings.allycolor or espSettings.boxcolor

    if espSettings.boxes then
        obj.box[1].From, obj.box[1].To = topLeft, topRight
        obj.box[2].From, obj.box[2].To = topRight, botRight
        obj.box[3].From, obj.box[3].To = botRight, botLeft
        obj.box[4].From, obj.box[4].To = botLeft, topLeft
        for _, l in next, obj.box do
            l.Color = color
            l.Visible = true
        end
    else
        for _, l in next, obj.box do l.Visible = false end
    end

    if espSettings.healthbar then
        local fraction = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        local barTop = Vector2.new(topLeft.X - 4, topLeft.Y)
        local barBottom = Vector2.new(topLeft.X - 4, bottomPos.Y)
        local filledBottom = Vector2.new(topLeft.X - 4, topLeft.Y + (bottomPos.Y - topLeft.Y) * (1 - fraction))
        obj.healthBack.From, obj.healthBack.To = barTop, barBottom
        obj.healthBack.Color = Color3.fromRGB(0, 0, 0)
        obj.healthBack.Visible = true
        obj.healthBar.From, obj.healthBar.To = filledBottom, barBottom
        obj.healthBar.Color = Color3.fromRGB(255 * (1 - fraction), 255 * fraction, 0)
        obj.healthBar.Visible = true
    else
        obj.healthBack.Visible = false
        obj.healthBar.Visible = false
    end

    if espSettings.names then
        obj.nameText.Text = plr.Name
        obj.nameText.Position = Vector2.new(topPos.X, topLeft.Y - 16)
        obj.nameText.Color = isAlly(plr) and espSettings.allycolor or espSettings.namecolor
        obj.nameText.Visible = true
    else
        obj.nameText.Visible = false
    end

    if espSettings.distancetext then
        obj.distanceText.Text = "[" .. math.floor(distance) .. "m]"
        obj.distanceText.Position = Vector2.new(topPos.X, bottomPos.Y + 2)
        obj.distanceText.Color = Color3.fromRGB(255, 255, 255)
        obj.distanceText.Visible = true
    else
        obj.distanceText.Visible = false
    end

    if espSettings.tracers then
        local screen = camera.ViewportSize
        obj.tracer.From = Vector2.new(screen.X / 2, screen.Y)
        obj.tracer.To = Vector2.new(botLeft.X + boxWidth / 2, botLeft.Y)
        obj.tracer.Color = color
        obj.tracer.Visible = true
    else
        obj.tracer.Visible = false
    end
end

