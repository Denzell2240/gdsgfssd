--==================================================

local tracerConfig = {
    enabled = false,
    type = "Laser",
    lifetime = 0.08,
    widthStart = 0.08,
    widthEnd = 0.02,
    color = Color3.fromRGB(255, 45, 210)
}

local function findTracerOrigin()
    local character = LocalPlayer.Character
    if not character then return nil end

    local muzzle = character:FindFirstChild("GunMuzzlePoint", true)
    if muzzle and muzzle:IsA("Attachment") then return muzzle end

    local firePoint = character:FindFirstChild("GunFirePoint", true)
    if firePoint and firePoint:IsA("Attachment") then return firePoint end

    return nil
end

local function makePoint(position)
    local p = Instance.new("Part")
    p.Name = "_TracerPoint"
    p.Size = Vector3.new(0.05, 0.05, 0.05)
    p.Transparency = 1
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Position = position
    p.Parent = workspace
    local att = Instance.new("Attachment")
    att.Parent = p
    return p, att
end

local function makeSeg(a0, a1, w0, w1, color, parent)
    local beam = Instance.new("Beam")
    beam.Attachment0 = a0
    beam.Attachment1 = a1
    beam.Width0 = w0
    beam.Width1 = w1
    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.LightInfluence = 0
    beam.Color = ColorSequence.new(color)
    beam.Transparency = NumberSequence.new(0)
    beam.Parent = parent or a0.Parent
    return beam
end

local function createTracer(originAttachment, targetPosition)
    if not originAttachment then return end

    local cfg = tracerConfig
    local dir = targetPosition - originAttachment.WorldPosition
    local dist = dir.Magnitude
    if dist < 0.5 then return end

    local style = cfg.type or "Laser"
    local color = cfg.color
    local life = cfg.lifetime

    if style == "Laser" then
        local p1, att1 = makePoint(targetPosition)
        local beam = makeSeg(originAttachment, att1, cfg.widthStart * 0.4, cfg.widthEnd * 0.4, color)
        Debris:AddItem(beam, life * 0.6)
        Debris:AddItem(p1, life * 0.6)

    elseif style == "Lightning" then
        local p1, att1 = makePoint(targetPosition)

        local boltColor = Color3.new(
            math.min(1, color.R * 0.3 + 0.7),
            math.min(1, color.G * 0.3 + 0.8),
            1
        )

        local core = makeSeg(originAttachment, att1, cfg.widthStart * 1.1, cfg.widthStart * 0.7, boltColor)
        local glow = makeSeg(originAttachment, att1, cfg.widthStart * 3, cfg.widthStart * 1.6, color)
        glow.Transparency = NumberSequence.new(0.6)

        Debris:AddItem(core, life * 1.4)
        Debris:AddItem(glow, life * 1.4)
        Debris:AddItem(p1, life * 1.4)

        task.spawn(function()
            while core.Parent do
                if math.random() > 0.25 then
                    core.Transparency = NumberSequence.new(math.random() * 0.35)
                    glow.Transparency = NumberSequence.new(0.45 + math.random() * 0.35)
                    glow.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), math.random() * 0.5))
                else
                    core.Transparency = NumberSequence.new(0.7)
                    glow.Transparency = NumberSequence.new(0.85)
                end
                RunService.Heartbeat:Wait()
            end
        end)
    else
        local p1, att1 = makePoint(targetPosition)
        local beam = makeSeg(originAttachment, att1, cfg.widthStart, cfg.widthEnd, color)
        Debris:AddItem(beam, life)
        Debris:AddItem(p1, life)
    end
end

mouse.Button1Down:Connect(function()
    if not tracerConfig.enabled then return end
    local origin = findTracerOrigin()
    if not origin then return end
    createTracer(origin, mouse.Hit.Position)
end)

