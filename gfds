-- is this player excluded from the aimbot?
local function isExcluded(plr)
    local selection = library.flags["aimbot excluded"]
    if type(selection) ~= "table" then return false end
    return table.find(selection, plr.Name) ~= nil
end

-- puts/removes the green dot marker above excluded players' heads
local function updateExcludedDots()
    for _, plr in ipairs(players:GetPlayers()) do
        if plr == localPlayer then continue end

        local head = plr.Character and plr.Character:FindFirstChild("Head")
        if not head then continue end

        local dot = head:FindFirstChild(EXCLUDED_DOT_NAME)

        if isExcluded(plr) then
            if not dot then
                local billboard = Instance.new("BillboardGui")
                billboard.Name = EXCLUDED_DOT_NAME
                billboard.Adornee = head
                billboard.Size = UDim2.fromOffset(14, 14)
                billboard.StudsOffset = Vector3.new(0, 2.2, 0)
                billboard.AlwaysOnTop = true
                billboard.Parent = head

                local circle = Instance.new("Frame")
                circle.AnchorPoint = Vector2.new(0.5, 0.5)
                circle.Position = UDim2.fromScale(0.5, 0.5)
                circle.Size = UDim2.fromScale(0.8, 0.8)
                circle.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                circle.BorderSizePixel = 0
                circle.Parent = billboard

                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(1, 0)
                corner.Parent = circle

                local stroke = Instance.new("UIStroke")
                stroke.Color = Color3.fromRGB(0, 110, 0)
                stroke.Thickness = 1.5
                stroke.Parent = circle
            end
        elseif dot then
            dot:Destroy()
        end
    end
end

