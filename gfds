local function isTargetable(char)
    if not char or char == LocalPlayer.Character then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if char:FindFirstChildOfClass("ForceField") then return false end
    if char:FindFirstChild("Invis") then return false end
    return true
end

-- cached ray that the namecall hook redirects to (crosshair -> best target part)
local cachedRay = nil

RunService.RenderStepped:Connect(function()
    cachedRay = nil

    local camera = workspace.CurrentCamera
    if not camera then return end

    -- FOV circle (screen center, accent colored)
    if saCircle then
        saCircle.Visible = silentAimSettings.enabled and silentAimSettings.showFov
        if saCircle.Visible then
            saCircle.Radius = silentAimSettings.fov
            local vp = camera.ViewportSize
            saCircle.Position = Vector2.new(vp.X / 2, vp.Y / 2)
            saCircle.Color = ACCENT
        end
    end

    if not silentAimSettings.enabled then return end

    -- pick the target closest to the crosshair inside the FOV circle
    local best, bestDist = nil, silentAimSettings.fov
    local center = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)

    for _, plr in ipairs(Players:GetPlayers()) do
        if silentAimSettings.teamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team then continue end
        local char = plr.Character
        if not isTargetable(char) then continue end

        local part = char:FindFirstChild(silentAimSettings.hitbox) or char:FindFirstChild("HumanoidRootPart")
        if part then
            local sp, onScreen = camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if d < bestDist then
                    best, bestDist = part, d
                end
            end
        end
    end

    if best then
        local origin = camera.CFrame.Position
        local dir = best.Position - origin

        -- wall check (only lock onto visible targets)
        if silentAimSettings.wallCheck and dir.Magnitude > 1 then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {LocalPlayer.Character, best.Parent}
            local result = workspace:Raycast(origin, dir, rayParams)
            if result then return end
        end

        if dir.Magnitude > 1 then
            cachedRay = Ray.new(origin, dir.Unit)
        end
    end
end)

-- __namecall hook: intercept the camera's aim-ray calls the game's shooting
-- code makes and swap them for our cached ray (target -> head).
--
-- ADS (scoped/crosshair shots) use ViewportPointToRay called with the exact
-- screen center. Hipfire shots use other ray calls (ScreenPointToRay /
-- ViewportPointToRay with mouse position), so when "Hipfire Silent Aim" is
-- enabled we redirect EVERY aim-ray call while a target is locked.
local nc = newcclosure or function(f) return f end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", nc(function(self, ...)
    local method = getnamecallmethod()

    if silentAimSettings.enabled
        and cachedRay
        and self == workspace.CurrentCamera
        and (method == "ViewportPointToRay" or method == "ScreenPointToRay")
    then
        -- hipfire mode: redirect everything
        if silentAimSettings.hipfire then
            return cachedRay
        end

        -- normal mode: only redirect exact screen-center calls (ADS)
        local x, y, depth = ...
        if method == "ViewportPointToRay" and depth == 0 then
            local vp = self.ViewportSize
            if math.abs((tonumber(x) or -1) - vp.X * 0.5) < 1
                and math.abs((tonumber(y) or -1) - vp.Y * 0.5) < 1
            then
                return cachedRay
            end
        end
    end

    return oldNamecall(self, ...)
end))

