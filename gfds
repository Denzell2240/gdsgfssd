local jumpSettings = {
    highJumpEnabled = false,
    jumpPower = 90,
    infiniteJump = false
}

local storedUseJumpPower = nil
local storedJumpPower = nil
local storedJumpHeight = nil

local function applyJumpToCharacter(character)
    if not jumpSettings.highJumpEnabled then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        humanoid = character:WaitForChild("Humanoid", 5)
        if not humanoid then return end
    end
    if storedUseJumpPower == nil then
        storedUseJumpPower = humanoid.UseJumpPower
        storedJumpPower = humanoid.JumpPower
        storedJumpHeight = humanoid.JumpHeight
    end
    humanoid.UseJumpPower = true
    humanoid.JumpPower = jumpSettings.jumpPower
end

local function restoreJump(character)
    character = character or LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    if storedUseJumpPower ~= nil then
        humanoid.UseJumpPower = storedUseJumpPower
        humanoid.JumpPower = storedJumpPower
        humanoid.JumpHeight = storedJumpHeight
        storedUseJumpPower = nil
        storedJumpPower = nil
        storedJumpHeight = nil
    end
end

local function setHighJump(state)
    jumpSettings.highJumpEnabled = state
    if state then
        applyJumpToCharacter(LocalPlayer.Character)
    else
        restoreJump()
    end
end

local function setJumpPower(value)
    jumpSettings.jumpPower = value
    if jumpSettings.highJumpEnabled then
        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.UseJumpPower = true
                humanoid.JumpPower = value
            end
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function(character)
    if jumpSettings.highJumpEnabled then
        task.wait(0.2)
        applyJumpToCharacter(character)
    end
end)

UserInputService.JumpRequest:Connect(function()
    if not jumpSettings.infiniteJump then return end
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.Jump = true
    end
end)

--==================================================
-- ZOOM (functional, from original)
--==================================================

local zoomSettings = {
    enabled = false,
    zoomFOV = 30,
    storedFOV = nil,
    zooming = false
}

local function getZoomKey()
    local key = Flags["zoom key"]
    if typeof(key) == "EnumItem" and key ~= Enum.KeyCode.Unknown then
        return key
    end
    return Enum.KeyCode.T
end

local function isZoomKeyDown()
    local key = getZoomKey()
    if key.EnumType == Enum.KeyCode then
        return UserInputService:IsKeyDown(key)
    else
        return UserInputService:IsMouseButtonPressed(key)
    end
end

local currentZoomTween = nil

local function startZoom()
    local camera = workspace.CurrentCamera
    if not camera or zoomSettings.zooming then return end
    zoomSettings.zooming = true
    zoomSettings.storedFOV = camera.FieldOfView
    if currentZoomTween then currentZoomTween:Cancel() end
    currentZoomTween = TweenService:Create(
        camera,
        TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {FieldOfView = math.clamp(zoomSettings.zoomFOV, 1, 120)}
    )
    currentZoomTween:Play()
end

local function stopZoom()
    local camera = workspace.CurrentCamera
    if not zoomSettings.zooming then return end
    zoomSettings.zooming = false
    if currentZoomTween then currentZoomTween:Cancel() end
    if camera and zoomSettings.storedFOV then
        currentZoomTween = TweenService:Create(
            camera,
            TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {FieldOfView = zoomSettings.storedFOV}
        )
        currentZoomTween:Play()
    end
end

local function setZoomEnabled(state)
    zoomSettings.enabled = state
    if not state and zoomSettings.zooming then
        stopZoom()
    end
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if not zoomSettings.enabled then return end
    if getZoomKey() == Enum.KeyCode.Unknown then return end
    if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode ~= getZoomKey() then return end
    if input.KeyCode == Enum.KeyCode.Unknown and input.UserInputType ~= getZoomKey() and getZoomKey().EnumType ~= Enum.UserInputType then return end

    if isZoomKeyDown() and not zoomSettings.zooming then
        startZoom()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not zoomSettings.zooming then return end
    if getZoomKey().EnumType == Enum.KeyCode and input.KeyCode == getZoomKey() then
        stopZoom()
    elseif getZoomKey().EnumType == Enum.UserInputType and input.UserInputType == getZoomKey() then
        stopZoom()
    end
end)

RunService.RenderStepped:Connect(function()
    if zoomSettings.zooming and not isZoomKeyDown() then
        stopZoom()
    end
end)

