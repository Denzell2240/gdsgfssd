--==================================================
-- SKELETON CONNECTIONS
--==================================================

local SKELETON_R15 = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},

    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},

    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},

    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},

    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"},
}

local SKELETON_R6 = {
    {"Head", "Torso"},
    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"},
}

local BOX_LINES = 8
local SKELETON_LINES = #SKELETON_R15

local espObjects = {}

local function createEspDrawings()
    local obj = {}

    -- 8 corner box segments
    obj.box = {}
    for i = 1, BOX_LINES do
        local l = Drawing.new("Line")
        l.Thickness = espSettings.boxthickness
        l.Transparency = 1
        l.Visible = false
        table.insert(obj.box, l)
    end

    -- skeleton lines (R15 has the most connections)
    obj.skeleton = {}
    for i = 1, SKELETON_LINES do
        local l = Drawing.new("Line")
        l.Thickness = espSettings.skeletonthickness
        l.Transparency = 1
        l.Visible = false
        table.insert(obj.skeleton, l)
    end

    obj.nameText = Drawing.new("Text")
    obj.nameText.Size = 13
    obj.nameText.Center = true
    obj.nameText.Outline = true
    obj.nameText.Font = 2
    obj.nameText.Visible = false

    obj.distanceText = Drawing.new("Text")
    obj.distanceText.Size = 13
    obj.distanceText.Center = true
    obj.distanceText.Outline = true
    obj.distanceText.Font = 2
    obj.distanceText.Visible = false

    obj.tracer = Drawing.new("Line")
    obj.tracer.Thickness = 1
    obj.tracer.Transparency = 0
    obj.tracer.Visible = false

    return obj
end

local function removeEsp(plr)
    local obj = espObjects[plr]
    if obj then
        pcall(function()
            for _, l in ipairs(obj.box) do l:Remove() end
            for _, l in ipairs(obj.skeleton) do l:Remove() end
            obj.nameText:Remove()
            obj.distanceText:Remove()
            obj.tracer:Remove()
        end)
        espObjects[plr] = nil
    end
end

local function clearEsp()
    for plr in pairs(espObjects) do
        removeEsp(plr)
    end
end

local function isAlly(plr)
    return espSettings.teamcheck and plr.Team == LocalPlayer.Team
end

-- hide every drawing owned by this object
local function hideEsp(obj)
    for _, l in ipairs(obj.box) do l.Visible = false end
    for _, l in ipairs(obj.skeleton) do l.Visible = false end
    obj.nameText.Visible = false
    obj.distanceText.Visible = false
    obj.tracer.Visible = false
end

--==================================================
-- ESP INSTANT DEATH HANDLING
-- watches every player's Humanoid; the moment they die their
-- drawings get deleted (no frozen box staying on screen)
--==================================================

local function watchPlayerEsp(plr)
    if plr == LocalPlayer then return end

    local function hookCharacter(char)
        local hum = char:WaitForChild("Humanoid", 10)
        if hum and hum:IsA("Humanoid") then
            hum.Died:Connect(function()
                removeEsp(plr)
            end)
            -- safety net in case Humanoid gets replaced / ragdoll deaths
            hum.HealthChanged:Connect(function(health)
                if health <= 0 then
                    removeEsp(plr)
                end
            end)
        end
    end

    if plr.Character then
        task.spawn(hookCharacter, plr.Character)
    end

    plr.CharacterAdded:Connect(function(char)
        hookCharacter(char)
    end)

    -- last resort: if the whole character gets removed, wipe the drawings
    plr.CharacterRemoving:Connect(function()
        removeEsp(plr)
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    task.spawn(watchPlayerEsp, plr)
end

Players.PlayerAdded:Connect(function(plr)
    watchPlayerEsp(plr)
end)

Players.PlayerRemoving:Connect(function(plr)
    removeEsp(plr)
end)

--==================================================
-- SCREEN BOUNDS (real bounding box from parts)
--==================================================

local function getScreenBounds(camera, character)
    local minX = math.huge
    local minY = math.huge
    local maxX = -math.huge
    local maxY = -math.huge

    local found = false

    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            local cf = part.CFrame
            local size = part.Size

            local x = size.X / 2
            local y = size.Y / 2
            local z = size.Z / 2

            local corners = {
                cf * Vector3.new( x,  y,  z),
                cf * Vector3.new( x,  y, -z),
                cf * Vector3.new( x, -y,  z),
                cf * Vector3.new( x, -y, -z),
                cf * Vector3.new(-x,  y,  z),
                cf * Vector3.new(-x,  y, -z),
                cf * Vector3.new(-x, -y,  z),
                cf * Vector3.new(-x, -y, -z),
            }

            for _, point in ipairs(corners) do
                local screen = camera:WorldToViewportPoint(point)
                if screen.Z > 0 then
                    minX = math.min(minX, screen.X)
                    minY = math.min(minY, screen.Y)
                    maxX = math.max(maxX, screen.X)
                    maxY = math.max(maxY, screen.Y)
                    found = true
                end
            end
        end
    end

    if not found then
        return nil
    end

    return minX, minY, maxX, maxY
end

--==================================================
-- CORNER BOX
--==================================================

local function updateCornerBox(obj, minX, minY, maxX, maxY, alpha, color)
    local width = maxX - minX
    local height = maxY - minY

    local corner = math.min(
        espSettings.cornerlength,
        width / 3,
        height / 3
    )

    local points = {
        -- Top left
        {Vector2.new(minX, minY), Vector2.new(minX + corner, minY)},
        {Vector2.new(minX, minY), Vector2.new(minX, minY + corner)},

        -- Top right
        {Vector2.new(maxX, minY), Vector2.new(maxX - corner, minY)},
        {Vector2.new(maxX, minY), Vector2.new(maxX, minY + corner)},

        -- Bottom left
        {Vector2.new(minX, maxY), Vector2.new(minX + corner, maxY)},
        {Vector2.new(minX, maxY), Vector2.new(minX, maxY - corner)},

        -- Bottom right
        {Vector2.new(maxX, maxY), Vector2.new(maxX - corner, maxY)},
        {Vector2.new(maxX, maxY), Vector2.new(maxX, maxY - corner)},
    }

    for i = 1, BOX_LINES do
        local line = obj.box[i]
        line.From = points[i][1]
        line.To = points[i][2]
        line.Color = color
        line.Thickness = espSettings.boxthickness
        line.Transparency = alpha
        line.Visible = true
    end
end

--==================================================
-- SKELETON (R6 / R15 auto-detected)
--==================================================

local function updateSkeleton(obj, camera, character, alpha)
    local parts = {}
    for _, object in ipairs(character:GetChildren()) do
        if object:IsA("BasePart") then
            parts[object.Name] = object
        end
    end

    local connections
    if parts.UpperTorso then
        connections = SKELETON_R15
    else
        connections = SKELETON_R6
    end

    local skelColor = espSettings.skeletoncolor

    for i, connection in ipairs(connections) do
        local line = obj.skeleton[i]

        local partA = parts[connection[1]]
        local partB = parts[connection[2]]

        if partA and partB then
            local a = camera:WorldToViewportPoint(partA.Position)
            local b = camera:WorldToViewportPoint(partB.Position)

            if a.Z > 0 and b.Z > 0 then
                line.From = Vector2.new(a.X, a.Y)
                line.To = Vector2.new(b.X, b.Y)
                line.Color = skelColor
                line.Thickness = espSettings.skeletonthickness
                line.Transparency = alpha
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end

    -- hide unused lines (R6 uses fewer than R15)
    for i = #connections + 1, #obj.skeleton do
        obj.skeleton[i].Visible = false
    end
end

--==================================================
-- ESP UPDATE (per player)
--==================================================

local function updateEspPlayer(plr, camera)
    if not espSettings.enabled or plr == LocalPlayer then return end

    local char = plr.Character

    -- player has no character (dead / despawned) -> nuke their drawings
    if not char then
        if espObjects[plr] then removeEsp(plr) end
        return
    end

    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char.PrimaryPart
    local hum = char:FindFirstChildOfClass("Humanoid")

    -- dead player -> instantly delete their ESP so nothing stays frozen
    if not root or not hum or hum.Health <= 0 then
        if espObjects[plr] then removeEsp(plr) end
        return
    end

    local distance = (camera.CFrame.Position - root.Position).Magnitude
    if distance > espSettings.maxdistance then
        local obj = espObjects[plr]
        if obj then hideEsp(obj) end
        return
    end

    local obj = espObjects[plr]
    if not obj then
        obj = createEspDrawings()
        espObjects[plr] = obj
    end

    -- distance fade
    local alpha = 1
    if espSettings.distancefade then
        alpha = math.clamp(1 - distance / espSettings.maxdistance, 0.15, 1)
    end

    -- real screen bounds from all character parts
    local minX, minY, maxX, maxY = getScreenBounds(camera, char)
    if not minX then
        hideEsp(obj)
        return
    end

    local color = isAlly(plr) and espSettings.allycolor or espSettings.boxcolor

    -- corner box
    if espSettings.boxes then
        updateCornerBox(obj, minX, minY, maxX, maxY, alpha, color)
    else
        for _, l in ipairs(obj.box) do l.Visible = false end
    end

    -- skeleton
    if espSettings.skeleton then
        updateSkeleton(obj, camera, char, alpha)
    else
        for _, l in ipairs(obj.skeleton) do l.Visible = false end
    end

    -- names
    if espSettings.names then
        obj.nameText.Text = plr.Name
        obj.nameText.Position = Vector2.new((minX + maxX) / 2, minY - 16)
        obj.nameText.Color = isAlly(plr) and espSettings.allycolor or espSettings.namecolor
        obj.nameText.Visible = true
    else
        obj.nameText.Visible = false
    end

    -- distance
    if espSettings.distancetext then
        obj.distanceText.Text = "[" .. math.floor(distance) .. "m]"
        obj.distanceText.Position = Vector2.new((minX + maxX) / 2, maxY + 2)
        obj.distanceText.Color = Color3.fromRGB(255, 255, 255)
        obj.distanceText.Visible = true
    else
        obj.distanceText.Visible = false
    end

    -- tracers (bottom of screen -> bottom of the box)
    if espSettings.tracers then
        local screen = camera.ViewportSize
        obj.tracer.From = Vector2.new(screen.X / 2, screen.Y)
        obj.tracer.To = Vector2.new((minX + maxX) / 2, maxY)
        obj.tracer.Color = color
        obj.tracer.Transparency = alpha
        obj.tracer.Visible = true
    else
        obj.tracer.Visible = false
    end
end

