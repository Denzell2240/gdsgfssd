-- FOV circle (rendered by the aimbot loop)
local aimCircle = Drawing.new("Circle")
aimCircle.Thickness = 1
aimCircle.NumSides = 60
aimCircle.Filled = false
aimCircle.Color = library.libColor
aimCircle.Visible = false

local function isAimKeyDown()
    local key = library.flags["aimbot key"]
    if typeof(key) == "EnumItem" then
        if key.EnumType == Enum.KeyCode then
            return inputService:IsKeyDown(key)
        else
            return inputService:IsMouseButtonPressed(key)
        end
    end
    return true -- no key bound, treat as held
end

local function getAimbotTarget(camera)
    local mouseLoc = inputService:GetMouseLocation()
    local mousePos = Vector2.new(mouseLoc.X, mouseLoc.Y)
    local radius = library.flags["aimbot fov"] or 150
    local shortest = math.huge
    local closest = nil

    for _, plr in next, players:GetPlayers() do
        if plr == localPlayer then continue end
        if library.flags["aimbot team check"] and plr.Team ~= nil and plr.Team == localPlayer.Team then continue end
        -- ✅ skip excluded players (never lock onto them)
        if isExcluded(plr) then continue end

        local character = plr.Character
        if not character then continue end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        local part = character:FindFirstChild(library.flags["aimbot hitbox"] or "Head")
        if not part then continue end

        local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if dist > radius or dist >= shortest then continue end

        if library.flags["aimbot wall check"] then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {localPlayer.Character, character}
            local result = workspace:Raycast(camera.CFrame.Position, part.Position - camera.CFrame.Position, rayParams)
            if result then continue end
        end

        shortest = dist
        closest = {part = part, character = character}
    end

    return closest
end

local autoFireDebounce = false

runService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera
    if not camera then return end

    -- green dot markers for excluded players (always visible, even when aimbot is off)
    updateExcludedDots()

    -- FOV circle rendering
    aimCircle.Visible = library.flags["aimbot fov circle"] == true and library.flags["aimbot"] == true
    if aimCircle.Visible then
        aimCircle.Radius = library.flags["aimbot fov"] or 150
        local mouseLoc = inputService:GetMouseLocation()
        aimCircle.Position = Vector2.new(mouseLoc.X, mouseLoc.Y)
        aimCircle.Color = library.libColor
    end

    if not library.flags["aimbot"] then return end

    local mode = library.flags["aimbot mode"]
    local active
    if mode == "Hold" then
        active = isAimKeyDown()
    elseif mode == "Always" then
        active = true
    else
        active = aimbotToggleState
    end
    if not active then return end

    local target = getAimbotTarget(camera)
    if not target then return end

    local smoothness = math.max(1, library.flags["aimbot smoothing"] or 1)
    local goalCFrame = CFrame.new(camera.CFrame.Position, target.part.Position)
    camera.CFrame = camera.CFrame:Lerp(goalCFrame, math.clamp(1 / smoothness, 0.05, 1))

    -- Auto Fire
    if library.flags["aimbot auto fire"] and not autoFireDebounce then
        local screenPos, onScreen = camera:WorldToViewportPoint(target.part.Position)
        local mouseLoc = inputService:GetMouseLocation()
        if onScreen and (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mouseLoc.X, mouseLoc.Y)).Magnitude <= 15 then
            autoFireDebounce = true
            pcall(function() mouse1click() end)
            task.delay(0.15, function()
                autoFireDebounce = false
            end)
        end
    end
end)

