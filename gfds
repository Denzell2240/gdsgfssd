local function removeWeaponDisplay(player)
    local character = player.Character
    if not character then return end

    local old = character:FindFirstChild("HeldWeaponDisplay")
    if old then
        old:Destroy()
    end
end

local function clearAllWeaponDisplays()
    for _, plr in next, players:GetPlayers() do
        removeWeaponDisplay(plr)
    end
end

local function updateWeaponDisplay(player)
    if not espSettings.itemesp then return end

    local character = player.Character
    if not character then return end

    -- don't render for ourselves (avoids cluttering own screen)
    if player == localPlayer then return end

    -- respects the ESP team check
    if espSettings.teamcheck and player.Team == localPlayer.Team then
        removeWeaponDisplay(player)
        return
    end

    local tool = nil

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            tool = child
            break
        end
    end

    removeWeaponDisplay(player)

    if not tool then
        return
    end

    local head = character:FindFirstChild("Head")
    if not head then return end

    -- respect the ESP max distance + own (shorter) weapon ESP distance
    local camera = workspace.CurrentCamera
    if not camera then return end
    local distance = (camera.CFrame.Position - head.Position).Magnitude
    if distance > espSettings.itemdistance then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "HeldWeaponDisplay"
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(180, 35)
    -- sits higher up when Names ESP is on so it never overlaps the drawn-in name text
    billboard.StudsOffset = Vector3.new(0, espSettings.names and 4.5 or 3, 0)
    billboard.AlwaysOnTop = true
