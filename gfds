--==================================================

local function addToggle(group, args)
    local flag = args.flag or args.text

    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, 0, 0, 38)
    Row.BackgroundTransparency = 1
    Row.LayoutOrder = #group:GetChildren() + 1
    Row.Parent = group

    local Hit = Instance.new("TextButton")
    Hit.Size = UDim2.new(1, 0, 1, 0)
    Hit.BackgroundTransparency = 1
    Hit.Text = ""
    Hit.AutoButtonColor = false
    Hit.Parent = Row

    local Title = Instance.new("TextLabel")
    Title.BackgroundTransparency = 1
    Title.Position = UDim2.new(0, 14, 0, 0)
    Title.Size = UDim2.new(1, -80, 1, 0)
    Title.Font = Enum.Font.GothamSemibold
    Title.Text = args.text
    Title.TextColor3 = COLORS.Text
    Title.TextSize = 11
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Row

    local Switch = Instance.new("TextButton")
    Switch.AnchorPoint = Vector2.new(1, 0.5)
    Switch.Position = args.keybindArgs and UDim2.new(1, -62, 0.5, 0) or UDim2.new(1, -14, 0.5, 0)
    Switch.Size = UDim2.new(0, 38, 0, 20)
    Switch.BackgroundColor3 = COLORS.ToggleOff
    Switch.BorderSizePixel = 0
    Switch.Text = ""
    Switch.AutoButtonColor = false
    Switch.Parent = Row
    corner(Switch, 20)

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 14, 0, 14)
    Knob.Position = UDim2.new(0, 3, 0.5, -7)
    Knob.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
    Knob.BorderSizePixel = 0
    Knob.Parent = Switch
    corner(Knob, 20)

    local state = args.value == true
    local obj = {}

    function obj.render()
        local onColor = accentDark()
        TweenService:Create(Switch, TweenInfo.new(0.14), {
            BackgroundColor3 = state and onColor or COLORS.ToggleOff
        }):Play()
        TweenService:Create(Knob, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        }):Play()
    end

    local function set(newState)
        state = newState == true
        Flags[flag] = state
        obj.render()
        if args.callback then
            args.callback(state)
        end
    end

    obj.set = set
    obj.row = Row

    Hit.MouseButton1Click:Connect(function() set(not state) end)
    Switch.MouseButton1Click:Connect(function() set(not state) end)

    Flags[flag] = state
    obj.render()

    Options[flag] = {
        type = "toggle",
        changeState = function(v) set(v) end,
        skipflag = args.skipflag,
        oldargs = args
    }
    table.insert(allToggles, obj)

    -- inline keybind support: toggle:addKeybind(...)
    function obj:addKeybind(kbArgs)
        local kb = Instance.new("TextButton")
        kb.AnchorPoint = Vector2.new(1, 0.5)
        kb.Position = UDim2.new(1, -14, 0.5, 0)
        kb.Size = UDim2.new(0, 40, 0, 22)
        kb.BackgroundColor3 = COLORS.Panel2
        kb.BorderSizePixel = 0
        kb.Font = Enum.Font.Gotham
        kb.Text = ""
        kb.TextColor3 = COLORS.Muted
        kb.TextSize = 9
        kb.AutoButtonColor = false
        kb.Parent = Row
        corner(kb, 5)
        stroke(kb)

        local kbFlag = kbArgs.flag
        local listening = false

        local function apply(key)
            Flags[kbFlag] = key
            kb.Text = keyNames[key] or (key and key.Name) or "none"
            kb.TextColor3 = COLORS.Muted
        end

        kb.MouseButton1Click:Connect(function()
            if listening then return end
            listening = true
            kb.Text = "..."
            kb.TextColor3 = ACCENT
        end)

        UserInputService.InputBegan:Connect(function(input, processed)
            local key = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode or input.UserInputType
            if listening then
                if not table.find(blacklisted, key) then
                    listening = false
                    apply(key)
                end
                return
            end
            if key == Flags[kbFlag] and not processed and kbArgs.callback then
                kbArgs.callback()
            end
        end)

        kb.Visible = Flags["show keybinds"] ~= false
        table.insert(keybindButtons, kb)

        Options[kbFlag] = {
            type = "keybind",
            changeState = apply,
            skipflag = kbArgs.skipflag,
            oldargs = kbArgs
        }
        apply(kbArgs.key or Enum.KeyCode.Unknown)

        return kb
    end

    return obj
end

