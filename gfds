-- notify system (Drawing based, like the original)
local notifyText
pcall(function()
    notifyText = Drawing.new("Text")
    notifyText.Font = 2
    notifyText.Size = 13
    notifyText.Outline = true
    notifyText.Color = Color3.new(1, 1, 1)
    notifyText.Position = Vector2.new(10, 60)
    notifyText.Visible = false
end)

local notifyPlaying = false
local function notify(text)
    if not notifyText then return end
    if notifyPlaying then return end
    notifyPlaying = true
    notifyText.Text = text
    notifyText.Transparency = 0
    notifyText.Visible = true
    task.spawn(function()
        for i = 0, 1, 0.1 do task.wait() notifyText.Transparency = i end
        task.wait(3)
        for i = 1, 0, -0.1 do task.wait() notifyText.Transparency = i end
        notifyPlaying = false
        notifyText.Visible = false
    end)
end

