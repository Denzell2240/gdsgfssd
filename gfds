local vehicleESPSettings = {
    enabled = false,
    outlineColor = Color3.fromRGB(255, 255, 255),
    maxdistance = 2000,
    showdistance = true
}

local vehicleESP = {}
local Cars = workspace:FindFirstChild("Cars")

local function getVehiclePart(vehicle)
    if vehicle.PrimaryPart then
        return vehicle.PrimaryPart
    end
    return vehicle:FindFirstChildWhichIsA("BasePart", true)
end

function removeVehicleESP(vehicle)
    local data = vehicleESP[vehicle]
    if not data then return end
    if data.highlight then data.highlight:Destroy() end
    if data.billboard then data.billboard:Destroy() end
    vehicleESP[vehicle] = nil
end

function createVehicleESP(vehicle)
    if not vehicleESPSettings.enabled then return end
    if not vehicle:IsA("Model") then return end
    if vehicleESP[vehicle] then return end

    local part = getVehiclePart(vehicle)
    if not part then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "_VehicleESP"
    highlight.Adornee = vehicle
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = vehicleESPSettings.outlineColor
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = vehicle

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "_VehicleESP_Name"
    billboard.Adornee = part
    billboard.Size = UDim2.fromOffset(220, 45)
    billboard.StudsOffset = Vector3.new(0, 5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = vehicle

    local label = Instance.new("TextLabel")
    label.Name = "Info"
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextColor3 = vehicleESPSettings.outlineColor
    label.TextStrokeTransparency = 0
    label.Text = vehicle.Name
    label.Parent = billboard

    vehicleESP[vehicle] = {
        highlight = highlight,
        billboard = billboard,
        label = label,
        part = part
    }
end

local function clearVehicleESP()
    for vehicle in pairs(vehicleESP) do
        removeVehicleESP(vehicle)
    end
end

local function setVehicleESP(state)
    vehicleESPSettings.enabled = state
    if not state then
        clearVehicleESP()
        return
    end
    if Cars then
        for _, vehicle in ipairs(Cars:GetChildren()) do
            createVehicleESP(vehicle)
        end
    end
end

task.spawn(function()
    Cars = Cars or workspace:WaitForChild("Cars", 10)
    if not Cars then warn("[Vehicle ESP] workspace.Cars not found after 10s") return end

    Cars.ChildAdded:Connect(function(vehicle)
        if vehicleESPSettings.enabled then
            task.wait()
            createVehicleESP(vehicle)
        end
    end)

    Cars.ChildRemoved:Connect(function(vehicle)
        removeVehicleESP(vehicle)
    end)

    if vehicleESPSettings.enabled then
        for _, vehicle in ipairs(Cars:GetChildren()) do
            createVehicleESP(vehicle)
        end
    end
end)

